// This shader is still a design sketch, not tested yet.
// For the features it implements, see Core/Geometry/AdaptiveMesh.h
#version 450

layout(local_size_x = 256) in;

// Structures matching CPU-side data
struct VertexDelta {
    vec3 value;           // Only x is used when normal-aligned
    float confidence;
    uint flags;           // Including normal-aligned flag
};

struct Pattern {
    vec3 samples[16];  // Fixed size pattern buffer
    float weights[16];
    uint sampleCount;
    float matchThreshold;
};

// Bindings matching the Vulkan descriptor sets
layout(set = 0, binding = 0) readonly buffer PatternBuffer {
    Pattern patterns[];
};

layout(set = 0, binding = 1) readonly buffer PreviousDeltaBuffer {
    VertexDelta previousDeltas[];
};

layout(set = 0, binding = 2) buffer PredictionBuffer {
    VertexDelta predictions[];
};

// Push constants for dynamic parameters
layout(push_constant) uniform PushConstants {
    uint vertexCount;
    uint patternCount;
    float predictionWeight;
    float similarityThreshold;
    bool isNormalAligned;  // Added flag
} pc;

// Helper function to evaluate pattern similarity
float evaluatePatternSimilarity(uint patternIndex, uint vertexIndex) {
    Pattern pattern = patterns[patternIndex];
    float similarity = 0.0;
    uint validSamples = 0;
    
    for (uint i = 0; i < pattern.sampleCount && i < 16; i++) {
        if (vertexIndex + i >= pc.vertexCount) break;
        
        float delta = pc.isNormalAligned ? 
            previousDeltas[vertexIndex + i].value.x :
            length(previousDeltas[vertexIndex + i].value);
            
        float patternValue = pc.isNormalAligned ? 
            pattern.samples[i].x :
            length(pattern.samples[i]);
            
        float weight = pattern.weights[i];
        
        // Simple magnitude comparison for normal-aligned
        float magRatio = min(abs(delta), abs(patternValue)) / 
                        max(abs(delta), abs(patternValue));
                        
        similarity += weight * magRatio;
        validSamples++;
    }
    
    return validSamples > 0 ? similarity / float(validSamples) : 0.0;
}

// Helper function to predict delta based on pattern
vec3 predictFromPattern(uint patternIndex, uint vertexIndex) {
    Pattern pattern = patterns[patternIndex];
    vec3 prediction = vec3(0.0);
    float totalWeight = 0.0;
    
    // Use previous deltas to predict next value based on pattern
    for (uint i = 0; i < pattern.sampleCount && i < 16; i++) {
        if (vertexIndex + i >= pc.vertexCount) break;
        
        vec3 prevDelta = previousDeltas[vertexIndex + i].value;
        vec3 patternDelta = pattern.samples[i];
        float weight = pattern.weights[i];
        
        if (pc.isNormalAligned) {
            // Simplified scalar computation for normal-aligned
            prediction.x += patternDelta.x * (prevDelta.x / patternDelta.x) * weight;
        } else {
            // Full vector computation for regular mode
            prediction += patternDelta * (length(prevDelta) / length(patternDelta)) * weight;
        }
        
        totalWeight += weight;
    }
    
    return totalWeight > 0.0 ? prediction / totalWeight : vec3(0.0);
}

void main() {
    uint vertexIndex = gl_GlobalInvocationID.x;
    if (vertexIndex >= pc.vertexCount) return;
    
    // Find best matching pattern
    float bestSimilarity = 0.0;
    uint bestPatternIndex = 0;
    
    for (uint i = 0; i < pc.patternCount; i++) {
        float similarity = evaluatePatternSimilarity(i, vertexIndex);
        if (similarity > bestSimilarity) {
            bestSimilarity = similarity;
            bestPatternIndex = i;
        }
    }
    
    // Generate prediction if similarity is above threshold
    VertexDelta prediction;
    prediction.flags = 0;
    
    if (bestSimilarity > pc.similarityThreshold) {
        prediction.value = predictFromPattern(bestPatternIndex, vertexIndex);
        prediction.confidence = bestSimilarity;
        prediction.flags |= 1;  // Set valid prediction flag
    } else {
        // Fallback to simple linear prediction
        prediction.value = vertexIndex > 0 ? 
            previousDeltas[vertexIndex - 1].value : 
            vec3(0.0);
        prediction.confidence = 0.3;    // Lower confindence for linear prediction
    }
    
    // Zero out unused components in normal-aligned mode
    if (pc.isNormalAligned) {
        prediction.value.yz = vec2(0.0);
    }
    
    predictions[vertexIndex] = prediction;
}


// Minimal unlit material for the Filament cube demo.
// Vertex color is passed through as the final emissive/baseColor with no lighting.
// Compiled to unlit_color.filamat with matc.exe (see BuildDemo notes).
material {
    name : unlit_color,
    shadingModel : unlit,
    requires : [ color ],
    culling  : none
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // getColor() returns the interpolated per-vertex color attribute.
        material.baseColor = getColor();
    }
}

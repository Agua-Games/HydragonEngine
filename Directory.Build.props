<?xml version="1.0" encoding="utf-8"?>
<!--
  Directory.Build.props
  Central MSBuild properties shared by ALL projects in the Hydragon solution.
  Auto-imported by MSBuild from the repo root down to each project.
  This is the "avoid editing each .vcxproj by hand" mechanism:
  change include/lib paths (e.g. Filament) here, once.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- vcpkg manifest mode: reads vcpkg.json in this folder automatically.
         Requires `vcpkg integrate install` once, or the VS vcpkg integration. -->
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestInstall>true</VcpkgManifestInstall>

    <!-- Filament SDK location, produced by the cmake install step of filament-src into this folder.
         Layout: include\ (public headers), lib\x86_64\ (static libs, flat), bin\ (matc, mipgen, ...).
         Backends built: Vulkan (primary) + OpenGL (fallback / future WebGL). CRT: /MD (dynamic).
         Override FilamentDir via environment variable if installed elsewhere. -->
    <FilamentDir Condition="'$(FilamentDir)' == ''">$(MSBuildThisFileDirectory)Engine\Source\ThirdParty\Filament\</FilamentDir>
    <FilamentInclude>$(FilamentDir)include\</FilamentInclude>
    <!-- Libs are installed flat under lib\x86_64\ (single Release /MD build). -->
    <FilamentLib>$(FilamentDir)lib\x86_64\</FilamentLib>
  </PropertyGroup>

  <!-- Filament is header + static libs. Enable this block once the SDK exists.
       Kept as a switch so Phase 0 (toolchain smoke test) compiles without it. -->
  <PropertyGroup>
    <UseFilament Condition="'$(UseFilament)' == ''">false</UseFilament>
  </PropertyGroup>

  <!-- C++ standard for the whole rewrite. Must live in a ClCompile ItemDefinitionGroup:
       cl.exe only reads LanguageStandard as ClCompile item metadata, not as a global property.
       Applied unconditionally so every project compiles as C++20 (Filament headers need >= C++17). -->
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(UseFilament)' == 'true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(FilamentInclude);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>HYDRAGON_USE_FILAMENT=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(FilamentLib);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- Core Filament static libs. bluevk = Vulkan backend, bluegl = OpenGL backend (fallback).
           shaders + smol-v support the Vulkan SPIR-V path. zstd = material bundle decompression.
           Platform libs (opengl32, gdi32, user32) are required by the GL backend on Windows. -->
      <AdditionalDependencies>filament.lib;backend.lib;bluevk.lib;bluegl.lib;shaders.lib;smol-v.lib;filabridge.lib;filaflat.lib;utils.lib;geometry.lib;ibl.lib;zstd.lib;opengl32.lib;gdi32.lib;user32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

</Project>

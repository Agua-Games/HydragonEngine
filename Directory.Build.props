<?xml version="1.0" encoding="utf-8"?>
<!--
  Directory.Build.props
  Central MSBuild properties shared by ALL projects in the Hydragon solution.
  Auto-imported by MSBuild from the repo root down to each project.
  This is the "avoid editing each .vcxproj by hand" mechanism:
  change include/lib paths (e.g. Filament) here, once.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <!-- C++ standard for the whole rewrite -->
    <LanguageStandard>stdcpp20</LanguageStandard>
    <CppLanguageStandard>c++20</CppLanguageStandard>

    <!-- vcpkg manifest mode: reads vcpkg.json in this folder automatically.
         Requires `vcpkg integrate install` once, or the VS vcpkg integration. -->
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestInstall>true</VcpkgManifestInstall>

    <!-- Prebuilt Filament SDK location (populated by scripts/setup.ps1).
         Override FilamentDir via environment variable if installed elsewhere. -->
    <FilamentDir Condition="'$(FilamentDir)' == ''">$(MSBuildThisFileDirectory)Engine\Source\ThirdParty\Filament\</FilamentDir>
    <FilamentInclude>$(FilamentDir)include\</FilamentInclude>
    <FilamentLib Condition="'$(Configuration)' == 'Debug'">$(FilamentDir)lib\x86_64\mdd\</FilamentLib>
    <FilamentLib Condition="'$(Configuration)' != 'Debug'">$(FilamentDir)lib\x86_64\md\</FilamentLib>
  </PropertyGroup>

  <!-- Filament is header + static libs. Enable this block once the SDK exists.
       Kept as a switch so Phase 0 (toolchain smoke test) compiles without it. -->
  <PropertyGroup>
    <UseFilament Condition="'$(UseFilament)' == ''">false</UseFilament>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(UseFilament)' == 'true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(FilamentInclude);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>HYDRAGON_USE_FILAMENT=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(FilamentLib);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>filament.lib;backend.lib;bluevk.lib;filabridge.lib;filaflat.lib;utils.lib;geometry.lib;smol-v.lib;vkshaders.lib;ibl.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

</Project>

# All folders starting with _ are local.
_*/

# Compiled python files.
*.py[cod]

# Visual Studio files.
/.vs
**/.vscode/ipch

# macOS files.
.DS_Store

# Generated license file.
PACKAGE-DEPS.yaml

# packman .user config
*.packman.xml.user

# kit user config
deps/**/user.toml

# vscode settings are copied and filled in from 'settings.json.template'
.vscode/settings.json

# PyCharm files.
/.idea/

# Linux in docker build $HOME dirs
/.nvidia-omniverse
/.local
/.cache

# Omniverse EULA breadcrumb
/.omniverse_eula_accepted.txt

# Streaming EventTrace
*.etli

# Hydragon assets, non-versioned (for now).  Scope is the ASSETS folder only:
# data/schemas/ (the API schema definitions) and data/shaders/ (the engine's MDL)
# are engine content and belong in the repository.
/source/extensions/hydragon.editor.core/data/assets/

# Local scratch files
scratch/
test_rot.txt

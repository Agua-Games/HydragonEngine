
# Ignore intermediate folders, build artifacts
Bin/
/Engine/Build/CMake/build/	# Ignore all files inside of ../CMake/build/
BuildOutput/
Cache/

# Ignore folders not needed for compiling source
Templates/


# Ignore CMake's cache and temporary files
/CMakeCache.txt
CMakeFiles/
/Makefile

# Ignore PLugin files which get generated
# when compiling the engine
/Plugins/**/*.dll
/Plugins/**/*.so
/Plugins/**/*.dylib

# Ignore ThirdParty files which get generated
# when compiling the engine
/Bin/**/*.dll
/Bin/**/*.so
/Bin/**/*.dylib

# Ignore ML models, to avoid huge file transfers
/Shared/Models_ML/

# Ignore heavy files, used for local temp storages, backups.
# Remove later the proper extensions, if deciding to use github for large files also.
*.rar
*.zip

# Ignore temporary files
*.log
*.bak
*.tmp
*.bkp

# Ignore OS files (Windows, macOS, etc.)
.DS_Store
Thumbs.db

# Ignore IDEs files
.idea/
.vs/
*.user
*.suo
*.userosscache

#Ignore Roadmap.md, for now
/Roadmap.md

#Ignore Roadmap chats
RoadmapChat/

# ---- HydragonNext (Filament-first rewrite) ----
# vcpkg clone and installed packages (managed by manifest / setup.ps1)
/HydragonNext/ThirdParty/vcpkg/
/HydragonNext/vcpkg_installed/
# Prebuilt Filament SDK (downloaded by scripts/setup.ps1, large binaries)
/HydragonNext/ThirdParty/Filament/
# Visual Studio / MSBuild output
/HydragonNext/**/x64/
/HydragonNext/**/Debug/
/HydragonNext/**/Release/
/HydragonNext/.vs/
/HydragonNext/**/*.user
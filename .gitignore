
# Ignore intermediate folders, build artifacts
Bin/
# Ignore CMake build output (e.g. Filament source build)
/Engine/Build/CMake/build/
BuildOutput/
Cache/

# Ignore folders not needed for compiling source
Templates/


# Ignore CMake's cache and temporary files
/CMakeCache.txt
CMakeFiles/
/Makefile

# Ignore PLugin files which get generated
# when compiling the engine
/Plugins/**/*.dll
/Plugins/**/*.so
/Plugins/**/*.dylib

# Ignore ThirdParty files which get generated
# when compiling the engine
/Bin/**/*.dll
/Bin/**/*.so
/Bin/**/*.dylib

# Ignore ML models, to avoid huge file transfers
/Shared/Models_ML/

# Ignore heavy files, used for local temp storages, backups.
# Remove later the proper extensions, if deciding to use github for large files also.
*.rar
*.zip

# Ignore temporary files
*.log
*.bak
*.tmp
*.bkp

# Ignore volatile scratch folder (local-only, e.g. external notes/attachments)
/temp/

# Ignore local-only Copilot agents/skills toolkit (personal, not project code)
/.github/

# Ignore OS files (Windows, macOS, etc.)
.DS_Store
Thumbs.db

# Ignore IDEs files
.idea/
.vs/
*.user
*.suo
*.userosscache

#Ignore Roadmap.md, for now
/Roadmap.md

#Ignore Roadmap chats
RoadmapChat/

# ---- Hydragon rewrite (Filament-first, VS-native) ----
# Legacy engine backup copy (preserved in git history + branch alpha-feature-vulkan-backend)
/EngineLegacy/
# vcpkg clone and installed packages (managed by manifest / setup.ps1)
/Engine/ThirdParty/vcpkg/
/vcpkg_installed/
# Filament: full source clone (Option 1: ignored until build validated, then formalized as submodule)
/Engine/ThirdParty/filament-src/
# Filament installed/prebuilt SDK (large binaries)
/Engine/ThirdParty/Filament/
# Visual Studio / MSBuild output
/x64/
/Engine/**/x64/
*.user